{
  "name": "8bit-kit",
  "version": "0.2.0",
  "description": "Shared code for 8-bit WebXR arcade games built with BabylonJS",
  "license": "MIT",
  "type": "module",
  "repository": "github:chfields/8bit-kit",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/babylon-features.js"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@babylonjs/core": "^8.3.1",
    "@babylonjs/gui": "^8.3.1",
    "@babylonjs/loaders": "^8.3.1"
  },
  "dependencies": {
    "earcut": "^3.0.1",
    "fontfaceobserver": "^2.3.0"
  },
  "devDependencies": {
    "@babylonjs/core": "8.3.1",
    "@babylonjs/gui": "8.3.1",
    "@babylonjs/loaders": "8.3.1",
    "@types/earcut": "^3.0.0",
    "@types/fontfaceobserver": "^2.1.3",
    "typescript": "~5.8.3",
    "vitest": "^3.2.7"
  }
}
